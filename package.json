{
  "name": "excalidraw-gcp-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx scripts/run-fidelity.ts --input=svg --name=icons",
    "test:update": "tsx scripts/run-fidelity.ts --input=svg --name=icons --update-baseline",
    "test:torture": "tsx scripts/run-fidelity.ts --input=tests/torture-svg --name=torture",
    "test:torture:update": "tsx scripts/run-fidelity.ts --input=tests/torture-svg --name=torture --update-baseline",
    "evidence": "tsx scripts/build-evidence.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.469.0",
    "points-on-path": "^0.2.1",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svgo": "^4.0.2"
  },
  "devDependencies": {
    "@excalidraw/utils": "0.1.3-test32",
    "@resvg/resvg-js": "^2.6.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^28.0.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "roughjs": "^4.6.6",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
