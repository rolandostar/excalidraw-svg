{
  "name": "excalidraw-svg",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:dead": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fidelity": "tsx scripts/run-fidelity.ts --input=svg --name=icons",
    "test:fidelity:update": "tsx scripts/run-fidelity.ts --input=svg --name=icons --update-baseline",
    "test:torture": "tsx scripts/run-fidelity.ts --input=tests/torture-svg --name=torture --comparisons=all",
    "test:torture:update": "tsx scripts/run-fidelity.ts --input=tests/torture-svg --name=torture --comparisons=all --update-baseline",
    "evidence": "tsx scripts/build-evidence.ts",
    "shoot": "tsx scripts/dev/shoot.ts",
    "verify:fonts": "tsx scripts/verify-font-strip.ts",
    "gen:font-metrics": "tsx scripts/gen-font-metrics.ts",
    "gen:og": "tsx scripts/dev/gen-og.ts"
  },
  "dependencies": {
    "@excalidraw/utils": "0.1.3-test32",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.469.0",
    "points-on-path": "^0.2.1",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svgo": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^28.0.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.1",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.1.1",
    "knip": "^6.32.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
