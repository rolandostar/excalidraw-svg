{
  "name": "Google Cloud categories",
  "description": "The 26 category marks from Google's 2026 icon refresh — one per product area, for labelling a region of a diagram rather than a single service.",
  "source": "Google Cloud",
  "sourceUrl": "https://cloud.google.com/icons",
  "license": "Google Cloud Platform icons, redistributed under Google's terms of use",
  "accent": "#34A853",
  "order": 20,
  "tags": [
    "gcp",
    "google cloud",
    "category"
  ],
  "_styling_note": "These are area marks, not services: they title a region of a diagram rather than sit in a flow. That makes a side label the useful default - the mark reads as a heading next to its name - and makes the green accent of the set, rather than product blue, the right label colour.",
  "defaults": {
    "showLabel": true,
    "labelPosition": "bottom",
    "labelFontFamily": 1,
    "labelFontSize": 18,
    "labelColor": "#34a853",
    "iconScale": 1
  },
  "presets": [
    {
      "id": "default",
      "label": "Default",
      "hint": "Excalifont 18px in green, label underneath"
    },
    {
      "id": "heading",
      "label": "Side label",
      "hint": "Mark beside its name, for titling a region",
      "options": {
        "iconScale": 1.5,
        "labelFontSize": 24,
        "labelPosition": "right"
      }
    },
    {
      "id": "large",
      "label": "Large",
      "hint": "Oversized mark for a section title",
      "options": {
        "iconScale": 1.5,
        "labelFontSize": 24
      }
    },
    {
      "id": "sketch",
      "label": "Sketch",
      "hint": "Hand-drawn frame around the mark",
      "options": {
        "showCard": true,
        "cardStyle": "sketch-box",
        "roughness": 2,
        "cardBgColor": "transparent",
        "cardStrokeColor": "#34a853",
        "labelPosition": "bottom",
        "padding": 12
      }
    },
    {
      "id": "chip",
      "label": "Chip",
      "hint": "Filled panel, label inside",
      "options": {
        "showCard": true,
        "cardStyle": "soft-card",
        "roughness": 0,
        "cardBgColor": "#e6f4ea",
        "cardStrokeColor": "transparent",
        "labelColor": "#1e293b",
        "labelPosition": "bottom",
        "padding": 12
      }
    },
    {
      "id": "bare",
      "label": "Bare",
      "hint": "Just the mark",
      "options": {
        "showLabel": false,
        "showCard": false
      }
    }
  ],
  "_categories_note": "Deliberately none. Every icon in this set *is* a category, so a second layer of filter chips over 26 items would sort categories into categories. The chip bar hides itself when a set declares a single bucket.",
  "_overrides_note": "Four names lost an ampersand on the way through the filesystem: '&' survives in a folder name but not in the flattened filename, and 'AI _ Machine Learning' had already substituted the '_' for a character a path cannot hold. These restore the intended titles.",
  "overrides": {
    "AI-Machine-Learning": {
      "title": "AI & Machine Learning"
    },
    "Hybrid-Multicloud": {
      "title": "Hybrid & Multicloud"
    },
    "Maps-Geospatial": {
      "title": "Maps & Geospatial"
    },
    "Web-Mobile": {
      "title": "Web & Mobile"
    }
  },
  "_synonyms_note": "Bidirectional search aliases. These matter more here than in a product set: nobody searches for the literal string 'Security Identity', they search 'iam'.",
