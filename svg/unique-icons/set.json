{
  "name": "Google Cloud products",
  "description": "Individual product marks from Google's 2026 icon refresh — the flagship services, redrawn. Fewer icons than the legacy set, but these are the current artwork.",
  "source": "Google Cloud",
  "sourceUrl": "https://cloud.google.com/icons",
  "license": "Google Cloud Platform icons, redistributed under Google's terms of use",
  "accent": "#A142F4",
  "order": 30,
  "tags": [
    "gcp",
    "google cloud"
  ],
  "_styling_note": "The 2026 marks are drawn with more internal detail than the legacy set, so they hold up at a slightly larger default size. Label colour follows the set accent rather than product blue, which keeps the two Google Cloud sets visually separable when icons from both land on one canvas.",
  "defaults": {
    "showLabel": false,
    "labelFontFamily": 5,
    "labelFontSize": 18,
    "labelColor": "#a142f4",
    "iconScale": 1.25
  },
  "presets": [
    {
      "id": "default",
      "label": "Default",
      "hint": "Just the marks at 120px - no label, no frame"
    },
    {
      "id": "labelled",
      "label": "Labelled",
      "hint": "Each mark with its product name underneath",
      "options": {
        "showLabel": true,
        "showCard": false
      }
    },
    {
      "id": "sketch",
      "label": "Sketch",
      "hint": "Hand-drawn hatched frame",
      "options": {
        "showCard": true,
        "showLabel": true,
        "cardCorners": "square",
        "cardStrokeWidth": 1,
        "cardFillStyle": "hachure",
        "cardBgColor": "#f3e8fd",
        "cardStrokeColor": "#a142f4",
        "cardRoughness": 2,
        "iconRoughness": 1,
        "padding": 12
      }
    },
    {
      "id": "dark-card",
      "label": "Dark card",
      "hint": "Soft dark panel",
      "options": {
        "showCard": true,
        "showLabel": true,
        "cardCorners": "rounded",
        "cardStrokeWidth": 1,
        "cardFillStyle": "solid",
        "cardBgColor": "rgba(30, 41, 59, 0.8)",
        "cardStrokeColor": "#a142f4",
        "cardRoughness": 0,
        "labelColor": "#f8fafc",
        "padding": 12
      }
    },
    {
      "id": "outline",
      "label": "Outline",
      "hint": "Unfilled frame, keeps the canvas showing through",
      "options": {
        "showCard": true,
        "showLabel": true,
        "cardCorners": "square",
        "cardStrokeWidth": 2,
        "cardFillStyle": "solid",
        "cardBgColor": "transparent",
        "cardStrokeColor": "#a142f4",
        "cardRoughness": 0,
        "padding": 12
      }
    },
    {
      "id": "tight",
      "label": "Tight",
      "hint": "Frame fitted to the artwork rather than its viewBox",
      "options": {
        "showCard": true,
        "showLabel": true,
        "cardCorners": "rounded",
        "cardStrokeWidth": 1,
        "cardFillStyle": "solid",
        "cardBgColor": "transparent",
        "cardStrokeColor": "#a142f4",
        "cardRoughness": 0,
        "fitFrame": true,
        "padding": 10
      }
    },
    {
      "id": "compact",
      "label": "Compact",
      "hint": "Smaller marks for a dense diagram",
      "options": {
        "iconScale": 0.75,
        "showLabel": true,
        "labelFontSize": 12
      }
    }
  ],
  "categories": [
    {
      "id": "ai-ml",
      "name": "AI & ML",
      "description": "Vertex AI and the AI Hypercomputer stack",
      "color": "#8AB4F8"
    },
    {
      "id": "compute",
      "name": "Compute",
      "description": "Cloud Run, GKE, Compute Engine, Anthos, Apigee",
      "color": "#81C995"
    },
    {
      "id": "data",
      "name": "Data & Storage",
      "description": "BigQuery, AlloyDB, Spanner, Cloud SQL, Cloud Storage, Looker",
      "color": "#FDE293"
    },
    {
      "id": "security",
      "name": "Security",
      "description": "Mandiant, Security Command Center, Security Operations",
      "color": "#C58AF9"
    },
    {
      "id": "general",
      "name": "General",
      "description": "Anything not matched by a rule above",
      "color": "#BDC1C6"
    }
  ],
  "_rules_note": "Ordered and first-wins, substring-matched against the filename. Written as explicit product names rather than short keywords: with only 19 files a clever pattern buys nothing and 'ai' alone is one new filename away from swallowing something it should not. 'general' is last and therefore the fallback; it is currently empty, and the chip bar hides empty buckets.",
  "rules": [
    {
      "category": "ai-ml",
      "match": [
        "ai-hypercomputer",
        "vertex"
      ]
    },
    {
      "category": "security",
      "match": [
        "mandiant",
        "security",
        "threat"
      ]
    },
    {
      "category": "data",
      "match": [
        "alloydb",
        "bigquery",
        "spanner",
        "sql",
        "storage",
        "hyperdisk",
        "looker"
      ]
    },
    {
      "category": "compute",
      "match": [
        "anthos",
        "apigee",
        "cloud-run",
        "compute",
        "distributed",
        "gke"
      ]
    }
  ],
  "_synonyms_note": "Bidirectional search aliases: any term in a group finds any other. Product marks are the case where this matters most, because the short form is what people actually type.",
